# Play Store upload keys - one block per app.
#
# Copy this file to keystore.properties (same folder) and fill it in.
# keystore.properties is git-ignored. NEVER commit it, and never put a
# password in this example file.
#
# Used only by a Play build:
#   gradlew bundleBrandRelease -PplayRelease=brand
#
# Rules for values:
#   - use forward slashes in paths (C:/keys/inflxbrand), not backslashes
#   - if a password contains a backslash, type it twice (\)
#   - storePassword = the key store password; keyPassword = the key's password
#     (Android Studio's "New Key Store" dialog asks for both)

brand.storeFile=C:/path/to/inflxbrand
brand.keyAlias=key0
brand.storePassword=
brand.keyPassword=

# influencer.storeFile=C:/path/to/inflxinfluencer
# influencer.keyAlias=key0
# influencer.storePassword=
# influencer.keyPassword=

# follower.storeFile=C:/path/to/inflxfollowers
# follower.keyAlias=key0
# follower.storePassword=
# follower.keyPassword=
