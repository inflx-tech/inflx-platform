{
  "name": "inflx",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev:backend": "cd backend && npm run dev",
    "dev:admin": "cd packages/admin-web && npm run dev -- --port 3003",
    "dev:brand": "cd packages/brand-web && npm run dev -- --port 3002",
    "dev:mobile": "cd packages/mobile && npx react-native start",
    "dev:android": "cd packages/mobile && npx react-native run-android",
    "dev:all": "concurrently \"npm run dev:backend\" \"npm run dev:admin\" \"npm run dev:brand\"",
    "publish-ota": "node scripts/publish-ota.js",
    "publish-ota:all": "node scripts/publish-ota.js all",
    "publish-ota:brand": "node scripts/publish-ota.js brand",
    "publish-ota:influencer": "node scripts/publish-ota.js influencer",
    "publish-ota:follower": "node scripts/publish-ota.js follower",
    "qa": "node qa/scripts/run-qa.mjs",
    "qa:web": "pnpm exec playwright test --config qa/playwright.config.ts",
    "qa:report": "node qa/scripts/qa-report.mjs",
    "qa:html": "pnpm exec playwright show-report qa/artifacts/html-report",
    "qa:mobile": "cd Packages/Mobile && npm test",
    "qa:db": "node qa/scripts/qa-db.mjs",
    "qa:db:up": "node qa/scripts/db-up.mjs",
    "qa:db:down": "node qa/scripts/db-down.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "concurrently": "^8.2.0"
  }
}
