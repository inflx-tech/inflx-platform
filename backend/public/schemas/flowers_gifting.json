{
  "category_key": "flowers_gifting",
  "label": "Flowers & Gifting",
  "icon": "🌹",
  "product_noun": "Product",
  "product_noun_plural": "Products",
  "features": {
    "sections": true,
    "veg_flag": false,
    "duration_mins": false,
    "variants": true,
    "stock": true,
    "booking": false,
    "enquiry_only": false,
    "availability": false
  },
  "sections": ["Bouquets", "Gift Hampers", "Cakes & Sweets", "Chocolates", "Plants", "Occasion Decor"],
  "booking_type": null,
  "availing_modes": ["pay_at_store", "online_order", "prebook"],
  "fields": [
    { "key": "name", "label": "Product Name", "type": "text", "required": true, "placeholder": "e.g. Rose Bouquet – 50 Stems" },
    { "key": "section", "label": "Category", "type": "select", "options": ["Bouquets", "Gift Hampers", "Cakes & Sweets", "Chocolates", "Plants", "Occasion Decor"], "required": false },
    { "key": "price", "label": "Price (₹)", "type": "number", "required": true, "placeholder": "999" },
    { "key": "description", "label": "Description", "type": "textarea", "required": false, "placeholder": "Brief description" },
    { "key": "image_url", "label": "Image URL", "type": "url", "required": false },
    { "key": "stock", "label": "Stock", "type": "number", "required": false, "placeholder": "Leave blank = unlimited" },
    { "key": "variants_json", "label": "Size & Customisation Options", "type": "variant_builder", "required": false, "placeholder": "e.g. Small / Medium / Large / Premium, Red / Pink / Mixed" }
  ],
  "buyer_config": {
    "show_veg_filter": false,
    "show_sections": true,
    "cta_label": "Visit Store"
  },

  "phase": 5,
  "status": "coming_soon",
  "super_category": "shop",

  "action_types": {
    "walkin_pay": {
      "enabled": true,
      "cta_label": "Visit & Pay via INFLX",
      "discount_levels": ["shop", "category", "product"]
    },
    "book_now": {
      "enabled": true,
      "cta_label": "Pre-book",
      "requires_date": true,
      "advance_percentage": 50
    },
    "online_order": {
      "enabled": true,
      "cta_label": "Order Online",
      "requires_address": true
    },
    "enquiry": {
      "enabled": false
    }
  },

  "listing_steps": [],

  "product_config": {
    "enabled": true,
    "required": false,
    "excel_upload": true,
    "fields": [
      { "key": "section", "type": "select", "options": ["Bouquets", "Gift Hampers", "Cakes & Sweets", "Chocolates", "Plants", "Occasion Decor"] },
      { "key": "variants_json", "type": "variant_builder" }
    ],
    "excel_columns": ["Product Name", "Category", "Price", "Size", "Customisation", "Stock"]
  },

  "card_config": {
    "accent": "#ec4899",
    "accent_dim": "rgba(236,72,153,0.1)",
    "icon": "🌹",
    "cta_primary": { "label": "Visit & Pay", "action": "walkin_pay", "color": "#ec4899" },
    "cta_secondary": { "label": "Order Online", "action": "online_order" },
    "price_display": { "source": "cheapest_item", "unit": "onwards" },
    "subtitle_template": "{locality} · {distance}",
    "tags": ["top_3_products"]
  },

  "quality_rules": [
    { "field": "business_name", "points": 20, "label": "Store name & contact" },
    { "items": "product", "min": 3, "points": 25, "label": "3+ products listed" },
    { "type": "photos", "min": 1, "points": 15, "label": "Photos uploaded" },
    { "field": "address", "points": 15, "label": "Address provided" },
    { "field": "phone", "points": 10, "label": "Contact number" }
  ]
}
