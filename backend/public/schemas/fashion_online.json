{
  "category_key": "fashion_online",
  "label": "Fashion (Online)",
  "icon": "🛍️",
  "product_noun": "Product",
  "product_noun_plural": "Products",
  "features": {
    "sections": true,
    "veg_flag": false,
    "duration_mins": false,
    "variants": true,
    "stock": true,
    "booking": false,
    "enquiry_only": false,
    "availability": false
  },
  "sections": [
    "Kurtas",
    "Sarees",
    "Suits",
    "Western Wear",
    "Kids Wear",
    "Accessories",
    "Footwear"
  ],
  "booking_type": null,
  "availing_modes": [
    "pay_at_store",
    "online_order"
  ],
  "fields": [
    {
      "key": "name",
      "label": "Product Name",
      "type": "text",
      "required": true,
      "placeholder": "e.g. Silk Saree"
    },
    {
      "key": "section",
      "label": "Category",
      "type": "select",
      "options": [
        "Kurtas",
        "Sarees",
        "Suits",
        "Western Wear",
        "Kids Wear",
        "Accessories",
        "Footwear"
      ],
      "required": false
    },
    {
      "key": "price",
      "label": "Price (₹)",
      "type": "number",
      "required": true,
      "placeholder": "1499"
    },
    {
      "key": "description",
      "label": "Product Description",
      "type": "textarea",
      "required": true,
      "placeholder": "Detailed product description"
    },
    {
      "key": "image_url",
      "label": "Image URL",
      "type": "url",
      "required": true
    },
    {
      "key": "stock",
      "label": "Stock",
      "type": "number",
      "required": false,
      "placeholder": "Leave blank = unlimited"
    },
    {
      "key": "variants_json",
      "label": "Sizes & Colors",
      "type": "variant_builder",
      "required": true,
      "placeholder": "e.g. S / M / L / XL, Red / Blue / Green"
    }
  ],
  "buyer_config": {
    "show_veg_filter": false,
    "show_sections": true,
    "cta_label": "Buy Now"
  },
  "phase": 3,
  "status": "coming_soon",
  "super_category": "shop",
  "action_types": {
    "walkin_pay": {
      "enabled": true,
      "cta_label": "Walk-in & Pay",
      "discount_levels": [
        "shop",
        "category",
        "product"
      ]
    },
    "online_order": {
      "enabled": true,
      "cta_label": "Buy Online",
      "delivery_supported": true
    },
    "book_now": {
      "enabled": false
    },
    "enquiry": {
      "enabled": false
    }
  },
  "listing_steps": [],
  "product_config": {
    "enabled": true,
    "required": true,
    "excel_upload": true,
    "fields": []
  },
  "card_config": {
    "accent": "#f59e0b",
    "accent_dim": "rgba(245,158,11,0.1)",
    "icon": "🛍️",
    "cta_primary": {
      "label": "Buy Now",
      "action": "online_order",
      "color": "#f59e0b"
    },
    "cta_secondary": {
      "label": "Visit Store",
      "action": "walkin_pay"
    },
    "price_display": {
      "source": "cheapest_item",
      "unit": "onwards"
    },
    "subtitle_template": "{store_type} · {locality} · {distance}",
    "tags": [
      "store_type",
      "top_3_products"
    ]
  },
  "quality_rules": [
    {
      "field": "business_name",
      "points": 20,
      "label": "Store name & contact"
    },
    {
      "items": "product",
      "min": 5,
      "points": 20,
      "label": "5+ products with images"
    },
    {
      "type": "photos",
      "min": 1,
      "points": 15,
      "label": "Store photos uploaded"
    }
  ]
}
