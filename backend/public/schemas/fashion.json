{
  "category_key": "fashion",
  "label": "Fashion & Apparel",
  "icon": "👗",
  "product_noun": "Item",
  "product_noun_plural": "Inventory",
  "super_category": "shop",
  "card_type": "product",
  "phase": 1,
  "status": "active",
  "features": {
    "sections": true,
    "veg_flag": false,
    "duration_mins": false,
    "variants": true,
    "stock": true,
    "booking": false,
    "enquiry_only": false,
    "availability": true,
    "master_catalogue": false,
    "returns": true
  },
  "sections": [
    "Tops",
    "Bottoms",
    "Dresses",
    "Ethnic Wear",
    "Outerwear",
    "Innerwear",
    "Sportswear",
    "Sleepwear",
    "Accessories",
    "Footwear",
    "Bags",
    "Jewellery"
  ],
  "availing_modes": [
    "pay_at_store",
    "online_order"
  ],
  "booking_type": null,
  "attributes_schema": {
    "section": {
      "key": "section",
      "type": "select",
      "label": "Category",
      "options": [
        "Tops",
        "Bottoms",
        "Dresses",
        "Ethnic Wear",
        "Outerwear",
        "Innerwear",
        "Sportswear",
        "Sleepwear",
        "Accessories",
        "Footwear",
        "Bags",
        "Jewellery"
      ],
      "required": true
    },
    "gender": {
      "key": "gender",
      "type": "select",
      "label": "For",
      "options": [
        "Men",
        "Women",
        "Unisex",
        "Kids",
        "Boys",
        "Girls"
      ]
    },
    "fabric": {
      "key": "fabric",
      "type": "string",
      "label": "Fabric / Material",
      "placeholder": "e.g. 100% Cotton, Polyester blend, Silk",
      "max": 80
    },
    "care_instructions": {
      "key": "care_instructions",
      "type": "string",
      "label": "Care instructions",
      "placeholder": "e.g. Machine wash cold, do not bleach",
      "max": 120
    },
    "description": {
      "key": "description",
      "type": "string",
      "label": "Description",
      "max": 280
    },
    "occasion": {
      "key": "occasion",
      "type": "multi_select",
      "label": "Occasion",
      "options": [
        "Casual",
        "Formal",
        "Party",
        "Wedding",
        "Festive",
        "Office",
        "Workout",
        "Beach",
        "Lounge"
      ]
    },
    "fit": {
      "key": "fit",
      "type": "select",
      "label": "Fit",
      "options": [
        "Slim",
        "Regular",
        "Relaxed",
        "Oversized",
        "Tailored"
      ]
    },
    "premium": {
      "key": "premium",
      "type": "boolean",
      "label": "Premium piece"
    },
    "return_policy_days": {
      "key": "return_policy_days",
      "type": "number",
      "label": "Return window (days)",
      "min": 0,
      "max": 30,
      "default": 7
    },
    "variants": {
      "key": "variants",
      "type": "variant_matrix",
      "label": "Size & Color variants"
    }
  },
  "cart_scope": "brand",
  "listing_steps": [
    {
      "id": "brand_basics",
      "title": "About your store",
      "subtitle": "Description, hours, modes, and policies",
      "component": "brand_fields",
      "writes_to": "brand",
      "field_keys": [
        "brand_description",
        "gender_focus",
        "offers_online_delivery",
        "ships_international",
        "hours_json",
        "amenities",
        "default_return_policy_days"
      ]
    },
    {
      "id": "brand_photos",
      "title": "Store photos",
      "subtitle": "Show off the storefront, racks, fitting rooms — anything that builds trust",
      "component": "photo_upload",
      "writes_to": "brand",
      "min_photos": 3,
      "max_photos": 12,
      "recommended_photos": 6
    },
    {
      "id": "preview",
      "title": "Preview your store",
      "subtitle": "How followers will see this",
      "component": "preview",
      "show_quality_score": true,
      "show_live_preview": true
    },
    {
      "id": "done",
      "title": "Store is live!",
      "subtitle": "Your inventory is now discoverable",
      "component": "done",
      "boost_tips": [
        "Add 10+ items to unlock the 'Full Collection' badge",
        "Photos in natural light convert at 2× the rate",
        "Mark fast-moving items as Premium for priority placement",
        "Set realistic return windows — 7 days is the industry baseline",
        "Enable online delivery if you can ship — doubles your reachable buyers"
      ]
    }
  ],
  "fields": [],
  "product_config": {
    "enabled": true,
    "required": true,
    "excel_upload": true,
    "master_catalogue": false,
    "storage_format": {
      "name": "wizard_state.name",
      "price": "wizard_state.price",
      "section": "wizard_state.section",
      "description": "wizard_state.description",
      "image_url": "wizard_state.image_url",
      "return_policy_days": "wizard_state.return_policy_days",
      "variants_json": {
        "gender": "wizard_state.gender",
        "fabric": "wizard_state.fabric",
        "care_instructions": "wizard_state.care_instructions",
        "occasion": "wizard_state.occasion",
        "fit": "wizard_state.fit",
        "premium": "wizard_state.premium"
      }
    },
    "fields": [],
    "excel_columns": [
      {
        "column": "Product Name",
        "field": "name",
        "required": true,
        "example": "Cotton T-Shirt"
      },
      {
        "column": "Category",
        "field": "section",
        "required": true,
        "example": "Tops"
      },
      {
        "column": "Base Price (₹)",
        "field": "price",
        "required": true,
        "example": "499"
      },
      {
        "column": "Gender",
        "field": "gender",
        "required": false,
        "example": "Unisex"
      },
      {
        "column": "Fabric",
        "field": "fabric",
        "required": false,
        "example": "100% Cotton"
      },
      {
        "column": "Description",
        "field": "description",
        "required": false,
        "example": "Soft round-neck cotton tee"
      },
      {
        "column": "Sizes (comma-separated)",
        "field": "sizes",
        "required": false,
        "example": "S, M, L, XL"
      },
      {
        "column": "Colors (comma-separated)",
        "field": "colors",
        "required": false,
        "example": "Black, White, Navy"
      },
      {
        "column": "Stock per Variant",
        "field": "stock_per_variant",
        "required": false,
        "example": "5"
      },
      {
        "column": "Return Window (days)",
        "field": "return_policy_days",
        "required": false,
        "example": "7"
      },
      {
        "column": "Image URL",
        "field": "image_url",
        "required": false,
        "example": "https://example.com/item.jpg"
      }
    ]
  },
  "brand_config": {
    "fields": {
      "brand_description": {
        "key": "brand_description",
        "type": "string",
        "label": "About your store",
        "max": 280,
        "placeholder": "Your style POV — what makes you different"
      },
      "gender_focus": {
        "key": "gender_focus",
        "type": "multi_select",
        "label": "Who do you dress? (pick all that apply)",
        "options": [
          "Men",
          "Women",
          "Unisex",
          "Kids"
        ],
        "required": true
      },
      "offers_online_delivery": {
        "key": "offers_online_delivery",
        "type": "boolean",
        "label": "I deliver online (ships across India)",
        "default": false,
        "follower_sync": {
          "text": "Online buyers reachable"
        }
      },
      "hours_json": {
        "key": "hours_json",
        "type": "weekly_schedule",
        "label": "Store hours (for walk-in)"
      },
      "amenities": {
        "key": "amenities",
        "type": "multi_select",
        "label": "Store amenities",
        "options": [
          "AC",
          "Parking",
          "Card Payment",
          "UPI Payment",
          "Trial Rooms",
          "Tailor Available",
          "Gift Wrapping",
          "Home Delivery",
          "Cash on Delivery",
          "Bridal Consultation"
        ]
      },
      "default_return_policy_days": {
        "key": "default_return_policy_days",
        "type": "number",
        "label": "Return window in days (optional — blank uses our standard)",
        "min": 0,
        "max": 30,
        "default": 7,
        "required": false
      },
      "ships_international": {
        "key": "ships_international",
        "type": "boolean",
        "default": false,
        "label": "I also ship internationally",
        "show_if": {
          "field": "offers_online_delivery",
          "value": true
        }
      }
    },
    "actions": [
      {
        "kind": "transactional",
        "action": "pay_at_store",
        "label": "Pay at Store",
        "priority": 1,
        "primary": true,
        "config": {
          "fields": [
            "amount"
          ]
        }
      },
      {
        "kind": "transactional",
        "action": "online_order",
        "label": "Order Online",
        "priority": 2,
        "config": {}
      },
      {
        "kind": "contact",
        "action": "call",
        "label": "Call",
        "source_fields": [
          "phone"
        ]
      },
      {
        "kind": "contact",
        "action": "whatsapp",
        "label": "WhatsApp",
        "source_fields": [
          "whatsapp",
          "phone"
        ]
      },
      {
        "kind": "contact",
        "action": "directions",
        "label": "Directions",
        "source_fields": [
          "google_maps_url",
          "address_line"
        ]
      },
      {
        "kind": "contact",
        "action": "share",
        "label": "Share Store",
        "source_fields": []
      }
    ],
    "photo_requirements": {
      "cover_required": true,
      "gallery_min": 3,
      "gallery_max": 12,
      "gallery_recommended": 6
    }
  },
  "buyer_config": {
    "discovery_surface": "feed",
    "filters": [
      "section",
      "gender",
      "occasion",
      "fit",
      "premium"
    ],
    "sort_options": [
      "distance",
      "price_low",
      "price_high",
      "newest",
      "trending"
    ],
    "default_sort": "trending"
  },
  "card_config": {
    "accent": "#ec4899",
    "accent_dim": "rgba(236,72,153,0.10)",
    "icon": "👗",
    "card_type": "product",
    "cta_primary": {
      "label": "Shop Now",
      "action": "online_order",
      "color": "#ec4899",
      "fallback_action": "walkin_pay",
      "fallback_label": "Visit & Pay"
    },
    "cta_secondary": null,
    "price_display": {
      "source": "price.amount",
      "unit": ""
    },
    "subtitle_template": "{section} · {brand_name}",
    "tags": [
      {
        "source": "gender",
        "format": "{value}",
        "show_if": true
      },
      {
        "source": "fit",
        "format": "{value}",
        "show_if": true
      },
      {
        "source": "premium",
        "text": "✨ Premium",
        "show_if": true,
        "highlight": true
      },
      {
        "source": "return_policy_days",
        "format": "{value}-day returns",
        "show_if": true
      }
    ],
    "detail_sections": [
      {
        "type": "description",
        "title": "About this piece",
        "source": "description"
      },
      {
        "type": "variant_selector",
        "title": "Size & Color",
        "source": "variants",
        "selection_required_to_purchase": true
      },
      {
        "type": "spec_grid",
        "title": "Details",
        "fields": [
          "fabric",
          "care_instructions",
          "fit",
          "gender"
        ]
      },
      {
        "type": "feature_chips",
        "title": "Best for",
        "source": "occasion"
      },
      {
        "type": "return_policy_notice",
        "title": "Return policy",
        "source": "return_policy_days"
      },
      {
        "type": "gallery",
        "title": "More photos",
        "source": "gallery",
        "layout": "carousel"
      }
    ]
  },
  "action_types": {
    "walkin_pay": {
      "endpoint": "/follower/pay-at-store"
    },
    "online_order": {
      "endpoint": "/follower/orders",
      "requires_variant_selection": true
    }
  },
  "quality_rules": [
    {
      "field": "brand_description",
      "scope": "brand",
      "points": 5,
      "label": "Add a store description"
    },
    {
      "field": "gender_focus",
      "scope": "brand",
      "points": 5,
      "label": "Set who you dress"
    },
    {
      "field": "hours_json",
      "scope": "brand",
      "points": 5,
      "label": "Set store hours"
    },
    {
      "field": "default_return_policy_days",
      "scope": "brand",
      "points": 5,
      "label": "Set return window"
    },
    {
      "type": "photos",
      "scope": "brand",
      "min": 3,
      "points": 10,
      "label": "Add 3 store photos"
    },
    {
      "type": "photos",
      "scope": "brand",
      "min": 6,
      "points": 5,
      "label": "Add 6+ photos for full gallery"
    },
    {
      "items": "product",
      "min": 5,
      "points": 15,
      "label": "Add at least 5 items"
    },
    {
      "items": "product",
      "min": 20,
      "points": 10,
      "label": "Add 20+ items for full collection"
    },
    {
      "field": "offers_online_delivery",
      "scope": "brand",
      "points": 10,
      "label": "Enable online delivery (doubles reach)"
    }
  ]
}
