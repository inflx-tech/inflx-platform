{
  "category_key": "salon",
  "label": "Salon",
  "icon": "💇",
  "product_noun": "Service",
  "product_noun_plural": "Services",
  "features": {
    "sections": true,
    "veg_flag": false,
    "duration_mins": true,
    "variants": false,
    "stock": false,
    "booking": true,
    "enquiry_only": false,
    "availability": false,
    "master_catalogue": true
  },
  "sections": [
    "Hair Men",
    "Hair Women",
    "Skin",
    "Nails",
    "Makeup",
    "Spa"
  ],
  "booking_type": "appointment",
  "availing_modes": [
    "prebook"
  ],
  "fields": [
    {
      "key": "name",
      "label": "Service Name",
      "type": "text",
      "required": true,
      "placeholder": "e.g. Hair Spa"
    },
    {
      "key": "section",
      "label": "Category",
      "type": "select",
      "options": [
        "Hair",
        "Skin",
        "Nails",
        "Makeup",
        "Spa"
      ],
      "required": false
    },
    {
      "key": "price",
      "label": "Starting Price (₹)",
      "type": "number",
      "required": true,
      "placeholder": "499"
    },
    {
      "key": "duration_mins",
      "label": "Duration",
      "type": "duration_select",
      "options": [
        15,
        30,
        45,
        60,
        90,
        120,
        180
      ],
      "required": true
    },
    {
      "key": "description",
      "label": "Description",
      "type": "textarea",
      "required": false,
      "placeholder": "Brief description"
    },
    {
      "key": "image_url",
      "label": "Image URL",
      "type": "url",
      "required": false
    }
  ],
  "buyer_config": {
    "show_veg_filter": false,
    "show_sections": true,
    "cta_label": "Book Appointment"
  },
  "phase": 2,
  "status": "coming_soon",
  "super_category": "groom",
  "action_types": {
    "book_now": {
      "enabled": true,
      "type": "slot_based",
      "cta_label": "Book Appointment",
      "requires_date": true,
      "requires_time_slot": true,
      "payment_mode": "token_or_full",
      "token_amount": null,
      "cancellation": "configurable"
    },
    "walkin_pay": {
      "enabled": true,
      "cta_label": "Walk-in & Pay",
      "discount_levels": [
        "shop",
        "category",
        "product"
      ]
    },
    "enquiry": {
      "enabled": false
    }
  },
  "listing_steps": [],
  "product_config": {
    "enabled": true,
    "required": false,
    "excel_upload": false,
    "fields": []
  },
  "card_config": {
    "accent": "#ec4899",
    "accent_dim": "rgba(236,72,153,0.1)",
    "icon": "💇",
    "cta_primary": {
      "label": "Book",
      "action": "book_slot",
      "color": "#ec4899"
    },
    "cta_secondary": {
      "label": "Walk-in",
      "action": "walkin_pay"
    },
    "price_display": {
      "source": "cheapest_item",
      "unit": "onwards"
    },
    "subtitle_template": "{salon_type} · {locality} · {distance}",
    "tags": [
      "salon_type",
      "top_3_services",
      "home_service"
    ]
  },
  "quality_rules": [
    {
      "field": "business_name",
      "points": 20,
      "label": "Salon name & contact"
    },
    {
      "items": "service",
      "min": 3,
      "points": 20,
      "label": "3+ services"
    },
    {
      "type": "photos",
      "min": 1,
      "points": 15,
      "label": "Photos uploaded"
    },
    {
      "field": "address",
      "points": 10,
      "label": "Address provided"
    }
  ]
}
