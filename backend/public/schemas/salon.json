{
  "category_key": "salon",
  "label": "Salon",
  "icon": "💇",
  "product_noun": "Service",
  "product_noun_plural": "Services",
  "super_category": "beauty",
  "card_type": "service",
  "phase": 1,
  "status": "active",
  "features": {
    "sections": true,
    "veg_flag": false,
    "duration_mins": true,
    "variants": false,
    "stock": false,
    "booking": true,
    "enquiry_only": false,
    "availability": true,
    "master_catalogue": true
  },
  "sections": [
    "Hair Men",
    "Hair Women",
    "Skin & Facials",
    "Nails",
    "Makeup",
    "Waxing & Threading",
    "Spa & Massage",
    "Bridal Packages"
  ],
  "availing_modes": [
    "prebook",
    "pay_at_store"
  ],
  "booking_type": "appointment",
  "attributes_schema": {
    "duration_mins": {
      "key": "duration_mins",
      "type": "number",
      "label": "Duration",
      "unit": "min",
      "required": true
    },
    "section": {
      "key": "section",
      "type": "select",
      "label": "Category",
      "options": [
        "Hair Men",
        "Hair Women",
        "Skin & Facials",
        "Nails",
        "Makeup",
        "Waxing & Threading",
        "Spa & Massage",
        "Bridal Packages"
      ],
      "required": true
    },
    "gender": {
      "key": "gender",
      "type": "select",
      "label": "For",
      "options": [
        "Men",
        "Women",
        "Unisex"
      ]
    },
    "premium": {
      "key": "premium",
      "type": "boolean",
      "label": "Premium service"
    },
    "requires_stylist_choice": {
      "key": "requires_stylist_choice",
      "type": "boolean",
      "label": "Buyer picks stylist"
    },
    "available_stylist_ids": {
      "key": "available_stylist_ids",
      "type": "string[]",
      "label": "Stylists offering this service"
    },
    "description": {
      "key": "description",
      "type": "string",
      "label": "Description",
      "max": 280
    },
    "inclusions": {
      "key": "inclusions",
      "type": "string[]",
      "label": "What's included",
      "max": 8
    },
    "before_after_images": {
      "key": "before_after_images",
      "type": "image[]",
      "label": "Before / After photos",
      "max": 6
    },
    "master_service_id": {
      "key": "master_service_id",
      "type": "string",
      "label": "Master service reference"
    }
  },
  "cart_scope": null,
  "listing_steps": [
    {
      "id": "brand_basics",
      "title": "About your salon",
      "subtitle": "Description, hours, and who you serve",
      "component": "brand_fields",
      "writes_to": "brand",
      "field_keys": [
        "salon_description",
        "gender_focus",
        "hours_json",
        "amenities",
        "accepts_walkins"
      ]
    },
    {
      "id": "brand_team",
      "title": "Your team",
      "subtitle": "Add your stylists — name, photo, what they do",
      "component": "brand_fields",
      "writes_to": "brand",
      "field_keys": [
        "team_members"
      ]
    },
    {
      "id": "brand_photos",
      "title": "Salon photos",
      "subtitle": "Show off your space — interior, chairs, treatment rooms",
      "component": "photo_upload",
      "writes_to": "brand",
      "min_photos": 3,
      "max_photos": 10,
      "recommended_photos": 5
    },
    {
      "id": "service_authoring",
      "title": "Pick & price your services",
      "subtitle": "Tap a service to add it. Tap again to set price, duration, stylists & photos — all in one place.",
      "component": "salon_service_inline",
      "writes_to": "listing",
      "master_source": "master_services",
      "filter_by": "section",
      "auto_fill_from": "master_services",
      "spec_fields": [
        "description",
        "inclusions",
        "gender",
        "duration_mins",
        "premium",
        "requires_stylist_choice",
        "available_stylist_ids",
        "before_after_images"
      ],
      "price_fields": [
        {
          "key": "price",
          "label": "Your price",
          "unit": "₹",
          "required": true,
          "benchmark_source": "master_services",
          "benchmark_fields": [
            "price_min",
            "price_max"
          ]
        }
      ]
    },
    {
      "id": "preview",
      "title": "Preview your service",
      "subtitle": "How followers will see this",
      "component": "preview",
      "show_quality_score": true,
      "show_live_preview": true
    },
    {
      "id": "done",
      "title": "Service is live!",
      "subtitle": "Your service is now bookable",
      "component": "done",
      "boost_tips": [
        "Add 3+ stylists to unlock the 'Full Team' badge",
        "Mark popular services as Premium for priority placement",
        "Add before / after photos — they convert at 2× the rate",
        "Enable walk-ins to capture passing customers",
        "Reach 15+ services for the 'Full Service' badge"
      ]
    }
  ],
  "fields": [],
  "product_config": {
    "enabled": true,
    "required": true,
    "excel_upload": true,
    "master_catalogue": true,
    "storage_format": {
      "name": "master_row.service_name",
      "price": "wizard_state.price",
      "category": "master_row.section",
      "description": "wizard_state.description",
      "gallery_json": "wizard_state.before_after_images",
      "variants_json": {
        "duration_mins": "wizard_state.duration_mins",
        "inclusions": "wizard_state.inclusions",
        "gender": "wizard_state.gender",
        "premium": "wizard_state.premium",
        "requires_stylist_choice": "wizard_state.requires_stylist_choice",
        "available_stylist_ids": "wizard_state.available_stylist_ids",
        "master_service_id": "master_row.id"
      }
    },
    "fields": [],
    "excel_columns": [
      {
        "column": "Service Name",
        "field": "name",
        "required": true,
        "example": "Hair Cut & Style"
      },
      {
        "column": "Section",
        "field": "section",
        "required": true,
        "example": "Hair Women"
      },
      {
        "column": "Duration (min)",
        "field": "duration_mins",
        "required": true,
        "example": "45"
      },
      {
        "column": "Price (₹)",
        "field": "price",
        "required": true,
        "example": "500"
      },
      {
        "column": "Description",
        "field": "description",
        "required": false,
        "example": "Includes wash, cut, blow-dry"
      },
      {
        "column": "Gender",
        "field": "gender",
        "required": false,
        "example": "Women"
      },
      {
        "column": "Premium",
        "field": "premium",
        "required": false,
        "example": "No"
      },
      {
        "column": "Stylist Choice Required",
        "field": "requires_stylist_choice",
        "required": false,
        "example": "Yes"
      },
      {
        "column": "Image URL",
        "field": "image_url",
        "required": false,
        "example": "https://example.com/service.jpg"
      }
    ]
  },
  "brand_config": {
    "fields": {
      "salon_description": {
        "key": "salon_description",
        "type": "string",
        "label": "About your salon",
        "max": 280,
        "placeholder": "Two lines about your salon, your specialties, your vibe"
      },
      "gender_focus": {
        "key": "gender_focus",
        "type": "select",
        "label": "Customer focus",
        "options": [
          "Unisex",
          "Women only",
          "Men only"
        ],
        "required": true
      },
      "hours_json": {
        "key": "hours_json",
        "type": "weekly_schedule",
        "label": "Operating hours",
        "required": true
      },
      "amenities": {
        "key": "amenities",
        "type": "multi_select",
        "label": "Amenities",
        "options": [
          "Wi-Fi",
          "AC",
          "Parking",
          "Card Payment",
          "UPI Payment",
          "Sterilized Tools",
          "Single-use Items",
          "Disabled Access",
          "Kids Welcome",
          "Refreshments"
        ]
      },
      "accepts_walkins": {
        "key": "accepts_walkins",
        "type": "boolean",
        "label": "Accept walk-in customers",
        "default": true
      },
      "team_members": {
        "key": "team_members",
        "type": "team_member_list",
        "label": "Stylists",
        "required": true,
        "min": 1,
        "max": 30
      }
    },
    "actions": [
      {
        "kind": "transactional",
        "action": "book_slot",
        "label": "Book Appointment",
        "priority": 1,
        "primary": true,
        "config": {
          "booking_type": "appointment",
          "fields": [
            "booking_date",
            "time_slot",
            "stylist_preference",
            "notes"
          ]
        }
      },
      {
        "kind": "transactional",
        "action": "pay_at_store",
        "label": "Pay at Store",
        "priority": 2,
        "config": {
          "fields": [
            "amount",
            "tip_amount"
          ]
        }
      },
      {
        "kind": "contact",
        "action": "call",
        "label": "Call",
        "source_fields": [
          "phone"
        ]
      },
      {
        "kind": "contact",
        "action": "whatsapp",
        "label": "WhatsApp",
        "source_fields": [
          "whatsapp",
          "phone"
        ]
      },
      {
        "kind": "contact",
        "action": "directions",
        "label": "Directions",
        "source_fields": [
          "google_maps_url",
          "address_line"
        ]
      }
    ],
    "photo_requirements": {
      "cover_required": true,
      "gallery_min": 3,
      "gallery_max": 10
    }
  },
  "buyer_config": {
    "discovery_surface": "feed",
    "filters": [
      "section",
      "gender",
      "premium",
      "duration_mins"
    ],
    "sort_options": [
      "distance",
      "price_low",
      "price_high",
      "rating",
      "duration_short"
    ],
    "default_sort": "distance"
  },
  "card_config": {
    "accent": "#7c3aed",
    "accent_dim": "rgba(124,58,237,0.08)",
    "icon": "💇",
    "card_type": "service",
    "cta_primary": {
      "label": "Book Slot",
      "action": "book_slot",
      "color": "#7c3aed"
    },
    "price_display": {
      "source": "price.amount",
      "unit": ""
    },
    "subtitle_template": "{section} · {duration_mins} min · {brand_name}",
    "tags": [
      {
        "source": "duration_mins",
        "format": "{value} min"
      },
      {
        "source": "gender",
        "format": "{value}",
        "show_if": true
      },
      {
        "source": "premium",
        "text": "✨ Premium",
        "show_if": true,
        "highlight": true
      },
      {
        "source": "requires_stylist_choice",
        "text": "Pick stylist",
        "show_if": true
      }
    ],
    "detail_sections": [
      {
        "type": "description",
        "title": "About this service",
        "source": "description"
      },
      {
        "type": "spec_grid",
        "title": "Details",
        "fields": [
          "duration_mins",
          "gender",
          "premium"
        ],
        "emphasized_field": {
          "key": "premium",
          "color": "amber"
        }
      },
      {
        "type": "feature_chips",
        "title": "What's included",
        "source": "inclusions"
      },
      {
        "type": "gallery",
        "title": "Before & After",
        "source": "before_after_images",
        "layout": "carousel"
      }
    ],
    "booking_config": {
      "type": "appointment",
      "fields": [
        "booking_date",
        "time_slot",
        "stylist_id",
        "notes"
      ],
      "payment_modes": [
        "token",
        "full"
      ],
      "token_amount": 100,
      "token_refundable": true,
      "refund_policy": "Full refund up to 4 hours before slot",
      "balance_text": "Balance paid at the salon",
      "endpoint": "/follower/prebook"
    }
  },
  "action_types": {
    "prebook": {
      "endpoint": "/follower/prebook",
      "booking_type": "appointment",
      "slot_source": "/follower/slots"
    }
  },
  "quality_rules": [
    {
      "field": "salon_description",
      "scope": "brand",
      "points": 5,
      "label": "Add a salon description"
    },
    {
      "field": "gender_focus",
      "scope": "brand",
      "points": 5,
      "label": "Set who you serve"
    },
    {
      "field": "hours_json",
      "scope": "brand",
      "points": 5,
      "label": "Set operating hours"
    },
    {
      "field": "amenities",
      "scope": "brand",
      "points": 5,
      "label": "List your amenities"
    },
    {
      "field": "team_members",
      "scope": "brand",
      "points": 10,
      "label": "Add at least one stylist"
    },
    {
      "type": "photos",
      "scope": "brand",
      "min": 3,
      "points": 10,
      "label": "Add 3 ambience photos"
    },
    {
      "type": "photos",
      "scope": "brand",
      "min": 5,
      "points": 5,
      "label": "Add 5+ photos for full gallery"
    },
    {
      "items": "services",
      "min": 5,
      "points": 15,
      "label": "Add at least 5 services"
    },
    {
      "items": "services",
      "min": 15,
      "points": 10,
      "label": "Add 15+ services for a complete menu"
    },
    {
      "field": "accepts_walkins",
      "scope": "brand",
      "points": 5,
      "label": "Confirm walk-in policy"
    }
  ]
}
