    {
      "key": "image_url",
      "label": "Image URL",
      "type": "url",
      "required": false
    },
    {
      "key": "variants_json",
      "label": "Add-on Services",
      "type": "variant_builder",
      "required": false
    }
  ],
  "buyer_config": {
    "show_veg_filter": false,
    "show_sections": false,
    "show_enquiry_form": true,
    "cta_label": "Enquire Now"
  },
  "phase": 4,
  "status": "coming_soon",
  "super_category": "events",
  "action_types": {
    "enquiry": {
      "enabled": true,
      "cta_label": "Enquire Now"
    },
    "book_now": {
      "enabled": true,
      "type": "date_range",
      "cta_label": "Check Availability",
      "requires_date": true
