{
  "category_key": "function_hall",
  "label": "Event Venues & Banquet Halls",
  "icon": "🏛️",
  "product_noun": "Package",
  "product_noun_plural": "Packages",
  "features": {
    "sections": false,
    "veg_flag": false,
    "duration_mins": false,
    "variants": true,
    "stock": false,
