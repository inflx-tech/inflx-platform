      "label": "Enquire",
      "action": "enquiry",
      "color": "#8b5cf6"
    },
    "cta_secondary": null,
    "price_display": {
      "source": "cheapest_item",
      "unit": "onwards"
    },
    "subtitle_template": "{locality} · Capacity: {capacity}",
    "tags": [
      "capacity",
      "amenities"
    ]
  },
  "quality_rules": [
    {
      "field": "business_name",
      "points": 20,
      "label": "Venue name & contact"
    },
    {
      "items": "package",
      "min": 1,
      "points": 20,
      "label": "1+ packages"
    },
    {
