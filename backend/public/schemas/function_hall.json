    "walkin_pay": {
      "enabled": false
    }
  },
  "listing_steps": [],
  "product_config": {
    "enabled": true,
    "required": false,
    "excel_upload": false,
    "fields": []
  },
  "card_config": {
    "accent": "#8b5cf6",
    "accent_dim": "rgba(139,92,246,0.1)",
    "icon": "🏛️",
