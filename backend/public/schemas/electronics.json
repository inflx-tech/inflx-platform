{
  "category_key": "electronics",
  "label": "Electronics & Gadgets",
  "icon": "📱",
  "product_noun": "Product",
  "product_noun_plural": "Products",
  "features": {
    "sections": true,
    "veg_flag": false,
    "duration_mins": false,
    "variants": true,
    "stock": true,
    "booking": false,
    "enquiry_only": false,
    "availability": false
  },
  "sections": ["Smartphones", "Laptops", "Tablets", "Audio", "Cameras", "Accessories", "Gaming"],
  "booking_type": null,
  "availing_modes": ["pay_at_store"],
  "fields": [
    { "key": "name", "label": "Product Name", "type": "text", "required": true, "placeholder": "e.g. iPhone 15 Pro" },
    { "key": "section", "label": "Category", "type": "select", "options": ["Smartphones", "Laptops", "Tablets", "Audio", "Cameras", "Accessories", "Gaming"], "required": false },
    { "key": "price", "label": "Price (₹)", "type": "number", "required": true, "placeholder": "49999" },
    { "key": "description", "label": "Description", "type": "textarea", "required": false, "placeholder": "Brief description" },
    { "key": "image_url", "label": "Image URL", "type": "url", "required": false },
    { "key": "stock", "label": "Stock", "type": "number", "required": false, "placeholder": "Leave blank = unlimited" },
    { "key": "variants_json", "label": "Storage & Color Options", "type": "variant_builder", "required": false, "placeholder": "e.g. 128GB / 256GB / 512GB, Black / Silver / Blue" }
  ],
  "buyer_config": {
    "show_veg_filter": false,
    "show_sections": true,
    "cta_label": "Visit Store"
  },

  "phase": 5,
  "status": "coming_soon",
  "super_category": "shop",

  "action_types": {
    "walkin_pay": {
      "enabled": true,
      "cta_label": "Visit & Pay via INFLX",
      "discount_levels": ["shop", "category", "product"]
    },
    "book_now": {
      "enabled": false
    },
    "online_order": {
      "enabled": false
    },
    "enquiry": {
      "enabled": false
    }
  },

  "listing_steps": [],

  "product_config": {
    "enabled": true,
    "required": false,
    "excel_upload": true,
    "fields": [
      { "key": "section", "type": "select", "options": ["Smartphones", "Laptops", "Tablets", "Audio", "Cameras", "Accessories", "Gaming"] },
      { "key": "variants_json", "type": "variant_builder" }
    ],
    "excel_columns": ["Product Name", "Category", "Price", "Storage", "Color", "Stock"]
  },

  "card_config": {
    "accent": "#3b82f6",
    "accent_dim": "rgba(59,130,246,0.1)",
    "icon": "📱",
    "cta_primary": { "label": "Visit & Pay", "action": "walkin_pay", "color": "#3b82f6" },
    "cta_secondary": null,
    "price_display": { "source": "cheapest_item", "unit": "onwards" },
    "subtitle_template": "{locality} · {distance}",
    "tags": ["top_3_products"]
  },

  "quality_rules": [
    { "field": "business_name", "points": 20, "label": "Store name & contact" },
    { "items": "product", "min": 3, "points": 25, "label": "3+ products listed" },
    { "type": "photos", "min": 1, "points": 15, "label": "Photos uploaded" },
    { "field": "address", "points": 15, "label": "Address provided" },
    { "field": "phone", "points": 10, "label": "Contact number" }
  ]
}
