{
  "category_key": "grocery",
  "label": "Grocery & Supermarkets",
  "icon": "🛒",
  "product_noun": "Product",
  "product_noun_plural": "Products",
  "features": {
    "sections": true,
    "veg_flag": false,
    "duration_mins": false,
    "variants": true,
    "stock": true,
    "booking": false,
    "enquiry_only": false,
    "availability": false
  },
  "sections": ["Staples", "Fruits & Vegetables", "Dairy", "Snacks", "Beverages", "Personal Care", "Household"],
  "booking_type": null,
  "availing_modes": ["pay_at_store", "online_order"],
  "fields": [
    { "key": "name", "label": "Product Name", "type": "text", "required": true, "placeholder": "e.g. Basmati Rice 5kg" },
    { "key": "section", "label": "Category", "type": "select", "options": ["Staples", "Fruits & Vegetables", "Dairy", "Snacks", "Beverages", "Personal Care", "Household"], "required": false },
    { "key": "price", "label": "Price (₹)", "type": "number", "required": true, "placeholder": "350" },
    { "key": "description", "label": "Description", "type": "textarea", "required": false, "placeholder": "Brief description" },
    { "key": "image_url", "label": "Image URL", "type": "url", "required": false },
    { "key": "stock", "label": "Stock", "type": "number", "required": false, "placeholder": "Leave blank = unlimited" },
    { "key": "variants_json", "label": "Weight & Pack Options", "type": "variant_builder", "required": false, "placeholder": "e.g. 500g / 1kg / 5kg / 10kg" }
  ],
  "buyer_config": {
    "show_veg_filter": false,
    "show_sections": true,
    "cta_label": "Visit Store"
  },

  "phase": 5,
  "status": "coming_soon",
  "super_category": "eat",

  "action_types": {
    "walkin_pay": {
      "enabled": true,
      "cta_label": "Visit & Pay via INFLX",
      "discount_levels": ["shop", "category", "product"]
    },
    "book_now": {
      "enabled": false
    },
    "online_order": {
      "enabled": true,
      "cta_label": "Order Online",
      "requires_address": true
    },
    "enquiry": {
      "enabled": false
    }
  },

  "listing_steps": [],

  "product_config": {
    "enabled": true,
    "required": false,
    "excel_upload": true,
    "fields": [
      { "key": "section", "type": "select", "options": ["Staples", "Fruits & Vegetables", "Dairy", "Snacks", "Beverages", "Personal Care", "Household"] },
      { "key": "variants_json", "type": "variant_builder" }
    ],
    "excel_columns": ["Product Name", "Category", "Price", "Weight", "Pack Size", "Stock"]
  },

  "card_config": {
    "accent": "#10b981",
    "accent_dim": "rgba(16,185,129,0.1)",
    "icon": "🛒",
    "cta_primary": { "label": "Visit & Pay", "action": "walkin_pay", "color": "#10b981" },
    "cta_secondary": { "label": "Order Online", "action": "online_order" },
    "price_display": { "source": "cheapest_item", "unit": "onwards" },
    "subtitle_template": "{locality} · {distance}",
    "tags": ["top_3_products"]
  },

  "quality_rules": [
    { "field": "business_name", "points": 20, "label": "Store name & contact" },
    { "items": "product", "min": 3, "points": 25, "label": "3+ products listed" },
    { "type": "photos", "min": 1, "points": 15, "label": "Photos uploaded" },
    { "field": "address", "points": 15, "label": "Address provided" },
    { "field": "phone", "points": 10, "label": "Contact number" }
  ]
}
