{
  "category_key": "furniture",
  "label": "Home Decor & Furniture",
  "icon": "🪴",
  "product_noun": "Product",
  "product_noun_plural": "Products",
  "features": {
    "sections": true,
    "veg_flag": false,
    "duration_mins": false,
    "variants": true,
    "stock": true,
    "booking": false,
    "enquiry_only": false,
    "availability": false
  },
  "sections": [
    "Living Room",
    "Bedroom",
    "Dining",
    "Kitchen",
    "Office",
    "Outdoor",
    "Decor"
  ],
  "booking_type": null,
  "availing_modes": [
    "pay_at_store",
    "online_order"
  ],
  "fields": [
    {
      "key": "name",
      "label": "Product Name",
      "type": "text",
      "required": true,
      "placeholder": "e.g. 3-Seater Sofa"
    },
    {
      "key": "section",
      "label": "Category",
      "type": "select",
      "options": [
        "Living Room",
        "Bedroom",
        "Dining",
        "Kitchen",
        "Office",
        "Outdoor",
        "Decor"
      ],
      "required": false
    },
    {
      "key": "price",
      "label": "Price (₹)",
      "type": "number",
      "required": true,
      "placeholder": "25000"
    },
    {
      "key": "description",
      "label": "Description",
      "type": "textarea",
      "required": false,
      "placeholder": "Brief description"
    },
    {
      "key": "image_url",
      "label": "Image URL",
      "type": "url",
      "required": false
    },
    {
      "key": "stock",
      "label": "Stock",
      "type": "number",
      "required": false,
      "placeholder": "Leave blank = unlimited"
    },
    {
      "key": "variants_json",
      "label": "Material & Finish Options",
      "type": "variant_builder",
      "required": false,
      "placeholder": "e.g. Teak / Sheesham / MDF, Natural / Walnut / White"
    }
  ],
  "buyer_config": {
    "show_veg_filter": false,
    "show_sections": true,
    "cta_label": "Visit Store"
  },
  "phase": 1,
  "status": "active",
  "super_category": "shop",
  "action_types": {
    "walkin_pay": {
      "enabled": true,
      "cta_label": "Visit & Pay via INFLX",
      "discount_levels": [
        "shop",
        "category",
        "product"
      ]
    },
    "book_now": {
      "enabled": false
    },
    "online_order": {
      "enabled": false
    },
    "enquiry": {
      "enabled": false
    }
  },
  "listing_steps": [
    {
      "id": "brand_basics",
      "title": "About your store",
      "subtitle": "Description, hours, delivery and policies",
      "component": "brand_fields",
      "writes_to": "brand",
      "field_keys": [
        "brand_description",
        "offers_online_delivery",
        "ships_international",
        "hours_json",
        "amenities",
        "default_return_policy_days"
      ]
    },
    {
      "id": "brand_photos",
      "title": "Store photos",
      "subtitle": "Showroom, workshop, delivery van — anything that builds trust",
      "component": "photo_upload",
      "writes_to": "brand",
      "min_photos": 3,
      "max_photos": 12,
      "recommended_photos": 6
    },
    {
      "id": "preview",
      "title": "Preview your store",
      "subtitle": "How followers will see this",
      "component": "preview",
      "show_quality_score": true,
      "show_live_preview": true
    },
    {
      "id": "done",
      "title": "Store is live!",
      "subtitle": "Now add your products from the Listings page",
      "component": "done",
      "boost_tips": [
        "Add photos per colour/finish — buyers compare finishes first",
        "Fill dimensions on big items — cuts return risk",
        "Enable Request Quote for made-to-order work",
        "Set a realistic lead time on custom pieces"
      ]
    }
  ],
  "product_config": {
    "enabled": true,
    "required": false,
    "excel_upload": true,
    "fields": [
      {
        "key": "section",
        "type": "select",
        "options": [
          "Living Room",
          "Bedroom",
          "Dining",
          "Kitchen",
          "Office",
          "Outdoor",
          "Decor"
        ]
      },
      {
        "key": "variants_json",
        "type": "variant_builder"
      }
    ],
    "excel_columns": [
      "Product Name",
      "Category",
      "Price",
      "Material",
      "Finish",
      "Stock"
    ]
  },
  "card_config": {
    "accent": "#10b981",
    "accent_dim": "rgba(16,185,129,0.1)",
    "icon": "🪴",
    "cta_primary": {
      "label": "Visit & Pay",
      "action": "walkin_pay",
      "color": "#10b981"
    },
    "cta_secondary": null,
    "price_display": {
      "source": "cheapest_item",
      "unit": "onwards"
    },
    "subtitle_template": "{locality} · {distance}",
    "tags": [
      "top_3_products"
    ]
  },
  "quality_rules": [
    {
      "field": "business_name",
      "points": 20,
      "label": "Store name & contact"
    },
    {
      "items": "product",
      "min": 3,
      "points": 25,
      "label": "3+ products listed"
    },
    {
      "type": "photos",
      "min": 1,
      "points": 15,
      "label": "Photos uploaded"
    },
    {
      "field": "address",
      "points": 15,
      "label": "Address provided"
    },
    {
      "field": "phone",
      "points": 10,
      "label": "Contact number"
    }
  ],
  "brand_config": {
    "fields": {
      "brand_description": {
        "key": "brand_description",
        "type": "string",
        "label": "About your store",
        "max": 280,
        "placeholder": "What you make/sell — e.g. solid-wood custom furniture, 20 years in business"
      },
      "offers_online_delivery": {
        "key": "offers_online_delivery",
        "type": "boolean",
        "default": false,
        "label": "I deliver online (ships across India)",
        "follower_sync": {
          "text": "Online buyers reachable"
        }
      },
      "ships_international": {
        "key": "ships_international",
        "type": "boolean",
        "default": false,
        "label": "I also ship internationally",
        "show_if": {
          "field": "offers_online_delivery",
          "value": true
        }
      },
      "hours_json": {
        "key": "hours_json",
        "type": "weekly_schedule",
        "label": "Store hours (for walk-in)"
      },
      "amenities": {
        "key": "amenities",
        "type": "multi_select",
        "label": "Store amenities",
        "options": [
          "AC Showroom",
          "Parking",
          "Card Payment",
          "UPI Payment",
          "Home Delivery",
          "Installation / Assembly",
          "Carpenter Support",
          "EMI Available",
          "Custom / Made-to-Order",
          "Bulk & Project Orders"
        ]
      },
      "default_return_policy_days": {
        "key": "default_return_policy_days",
        "type": "number",
        "min": 0,
        "max": 30,
        "default": 7,
        "required": false,
        "label": "Return window in days (optional — blank uses our standard)"
      }
    },
    "photo_requirements": {
      "cover_required": true,
      "gallery_min": 3,
      "gallery_max": 12,
      "gallery_recommended": 6
    },
    "actions": [
      {
        "kind": "transactional",
        "action": "pay_at_store",
        "label": "Pay at Store",
        "priority": 1,
        "primary": true,
        "config": {
          "fields": [
            "amount"
          ]
        }
      },
      {
        "kind": "contact",
        "action": "directions",
        "label": "Directions",
        "source_fields": [
          "google_maps_url",
          "address_line",
          "latitude"
        ]
      }
    ]
  }
}
