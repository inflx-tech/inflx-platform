{
  "category_key": "restaurant",
  "label": "Restaurant",
  "icon": "🍽️",
  "product_noun": "Menu Item",
  "product_noun_plural": "Menu",
  "super_category": "eat",
  "card_type": "menu_item",
  "phase": 1,
  "status": "active",

  "features": {
    "sections": true,
    "veg_flag": true,
    "duration_mins": false,
    "variants": true,
    "stock": true,
    "booking": true,
    "enquiry_only": false,
    "availability": true,
    "master_catalogue": false
  },

  "sections": [
    "Starters",
    "Soups",
    "Main Course",
    "Breads",
    "Rice & Biryani",
    "Sides",
    "Desserts",
    "Beverages"
  ],

  "availing_modes": ["online_order"],
  "booking_type": null,

  "attributes_schema": {
    "veg_flag": {
      "key": "veg_flag",
      "type": "veg_toggle",
      "label": "Veg / Non-Veg",
      "required": true
    },
    "section": {
      "key": "section",
      "type": "select",
      "label": "Section",
      "options": ["Starters","Soups","Main Course","Breads","Rice & Biryani","Sides","Desserts","Beverages"],
      "required": true
    },
    "spice_level": {
      "key": "spice_level",
      "type": "select",
      "label": "Spice Level",
      "options": ["Mild","Medium","Hot","Extra Hot"]
    },
    "portion_size": {
      "key": "portion_size",
      "type": "select",
      "label": "Portion",
      "options": ["Half","Full","Regular"]
    },
    "bestseller": {
      "key": "bestseller",
      "type": "boolean",
      "label": "Bestseller"
    },
    "chef_special": {
      "key": "chef_special",
      "type": "boolean",
      "label": "Chef's Special"
    },
    "contains_egg": {
      "key": "contains_egg",
      "type": "boolean",
      "label": "Contains Egg"
    },
    "jain_available": {
      "key": "jain_available",
      "type": "boolean",
      "label": "Jain Option Available"
    },
    "description": {
      "key": "description",
      "type": "string",
      "label": "Description",
      "max": 240
    },
    "stock": {
      "key": "stock",
      "type": "number",
      "label": "Daily Stock"
    }
  },

  "cart_scope": "brand",

  "listing_steps": [
    {
      "id": "brand_basics",
      "title": "Tell us about your restaurant",
      "subtitle": "Cuisines, hours, and a short description",
      "component": "brand_fields",
      "writes_to": "brand",
      "field_keys": [
        "cuisines",
        "restaurant_description",
        "hours_json"
      ]
    },
    {
      "id": "brand_dining",
      "title": "Dining setup",
      "subtitle": "Tables, parking, and what you support",
      "component": "brand_fields",
      "writes_to": "brand",
      "field_keys": [
        "table_count",
        "parking",
        "dine_in_supported",
        "takeaway_supported",
        "accepts_table_booking",
        "min_order_value",
        "delivery_fee"
      ]
    },
    {
      "id": "brand_photos",
      "title": "Restaurant photos",
      "subtitle": "Show off your space — interior, exterior, signature spreads",
      "component": "photo_upload",
      "writes_to": "brand",
      "min_photos": 3,
      "max_photos": 12,
      "recommended_photos": 6
    },
    {
      "id": "menu",
      "title": "Add your menu",
      "subtitle": "Browse popular dishes by cuisine, or bulk-upload an Excel sheet",
      "component": "restaurant_dish_picker",
      "writes_to": "listing",
      "group_by_section": true,
      "max_items": 500,
      "item_fields": [
        {
          "key": "name",
          "type": "string",
          "label": "Item name",
          "required": true,
          "max": 80,
          "placeholder": "e.g. Butter Chicken"
        },
        {
          "key": "price",
          "type": "number",
          "label": "Price",
          "unit": "₹",
          "required": true
        },
        {
          "key": "veg_flag",
          "type": "veg_toggle",
          "label": "Veg / Non-Veg",
          "required": true
        },
        {
          "key": "section",
          "type": "select",
          "label": "Section",
          "required": true,
          "options": ["Starters","Soups","Main Course","Breads","Rice & Biryani","Sides","Desserts","Beverages"]
        },
        {
          "key": "description",
          "type": "string",
          "label": "Description",
          "max": 240,
          "placeholder": "Tender chicken simmered in rich tomato gravy"
        },
        {
          "key": "image_url",
          "type": "image",
          "label": "Photo of this dish"
        },
        {
          "key": "spice_level",
          "type": "select",
          "label": "Spice level",
          "options": ["Mild","Medium","Hot","Extra Hot"]
        },
        {
          "key": "portion_size",
          "type": "select",
          "label": "Portion",
          "options": ["Half","Full","Regular"],
          "default": "Full"
        },
        {
          "key": "bestseller",
          "type": "boolean",
          "label": "Mark as Bestseller",
          "default": false
        },
        {
          "key": "chef_special",
          "type": "boolean",
          "label": "Chef's Special",
          "default": false
        },
        {
          "key": "contains_egg",
          "type": "boolean",
          "label": "Contains egg",
          "default": false
        },
        {
          "key": "jain_available",
          "type": "boolean",
          "label": "Jain option available",
          "default": false
        },
        {
          "key": "stock",
          "type": "number",
          "label": "Daily stock (optional)"
        }
      ]
    },
    {
      "id": "preview",
      "title": "Preview your store",
      "subtitle": "How followers will see your restaurant",
      "component": "preview",
      "show_quality_score": true,
      "show_live_preview": true
    },
    {
      "id": "done",
      "title": "You're live!",
      "subtitle": "Your restaurant is now discoverable",
      "component": "done",
      "boost_tips": [
        "Add 6+ ambience photos to feature in 'Highlighted Restaurants'",
        "Mark at least 5 items as Bestsellers — they get priority on cards",
        "Enable table booking to unlock the 'Reservations' badge",
        "Fill descriptions for 80% of menu items to reach Standard quality",
        "Add a delivery fee and minimum order value to enable online order"
      ]
    }
  ],

  "fields": [],

  "product_config": {
    "enabled": true,
    "required": true,
    "excel_upload": true,
    "master_catalogue": false,
    "storage_format": {
      "name": "wizard_state.name",
      "price": "wizard_state.price",
      "category": "wizard_state.section",
      "description": "wizard_state.description",
      "image_url": "wizard_state.image_url",
      "variants_json": {
        "veg_flag": "wizard_state.veg_flag",
        "spice_level": "wizard_state.spice_level",
        "portion_size": "wizard_state.portion_size",
        "bestseller": "wizard_state.bestseller",
        "chef_special": "wizard_state.chef_special",
        "contains_egg": "wizard_state.contains_egg",
        "jain_available": "wizard_state.jain_available"
      },
      "availability_json": {
        "daily_stock": "wizard_state.stock"
      }
    },
    "fields": [],
    "excel_columns": [
      { "column": "Item Name", "field": "name", "required": true, "example": "Butter Chicken" },
      { "column": "Section", "field": "section", "required": true, "example": "Main Course" },
      { "column": "Price (₹)", "field": "price", "required": true, "example": "320" },
      { "column": "Veg/Non-Veg", "field": "veg_flag", "required": true, "example": "Non-Veg" },
      { "column": "Description", "field": "description", "required": false, "example": "Tender chicken in rich tomato gravy" },
      { "column": "Spice Level", "field": "spice_level", "required": false, "example": "Medium" },
      { "column": "Portion", "field": "portion_size", "required": false, "example": "Full" },
      { "column": "Bestseller", "field": "bestseller", "required": false, "example": "Yes" },
      { "column": "Chef's Special", "field": "chef_special", "required": false, "example": "No" },
      { "column": "Contains Egg", "field": "contains_egg", "required": false, "example": "No" },
      { "column": "Jain Option", "field": "jain_available", "required": false, "example": "No" },
      { "column": "Daily Stock", "field": "stock", "required": false, "example": "50" }
    ]
  },

  "brand_config": {
    "fields": {
      "cuisines": {
        "key": "cuisines",
        "type": "multi_select",
        "label": "Cuisines",
        "options": [
          "North Indian","South Indian","Chinese","Continental","Biryani","Tandoor",
          "Mughlai","Andhra","Hyderabadi","Bengali","Gujarati","Punjabi",
          "Italian","Mexican","Thai","Japanese","Desserts","Fast Food","Cafe","Beverages"
        ],
        "required": true,
        "max": 4
      },
      "restaurant_description": {
        "key": "restaurant_description",
        "type": "string",
        "label": "About your restaurant",
        "max": 280,
        "placeholder": "Two lines about your kitchen, your story, your specialty"
      },
      "hours_json": {
        "key": "hours_json",
        "type": "weekly_schedule",
        "label": "Operating hours",
        "required": true
      },
      "photos": {
        "key": "photos",
        "type": "image[]",
        "label": "Restaurant photos",
        "max": 12
      },
      "table_count": {
        "key": "table_count",
        "type": "number",
        "label": "Number of tables"
      },
      "parking": {
        "key": "parking",
        "type": "boolean",
        "label": "Parking available",
        "default": false
      },
      "dine_in_supported": {
        "key": "dine_in_supported",
        "type": "boolean",
        "label": "Dine-in available",
        "default": true
      },
      "takeaway_supported": {
        "key": "takeaway_supported",
        "type": "boolean",
        "label": "Takeaway available",
        "default": true
      },
      "accepts_table_booking": {
        "key": "accepts_table_booking",
        "type": "boolean",
        "label": "Accept table bookings",
        "default": false
      },
      "min_order_value": {
        "key": "min_order_value",
        "type": "number",
        "label": "Minimum order value",
        "unit": "₹",
        "default": 0
      },
      "delivery_fee": {
        "key": "delivery_fee",
        "type": "number",
        "label": "Delivery fee",
        "unit": "₹",
        "default": 0
      }
    },
    "actions": [
      {
        "kind": "transactional",
        "action": "book_slot",
        "label": "Book Table",
        "config": {
          "booking_type": "table",
          "fields": ["booking_date","time_slot","guest_count","special_requests"],
          "payment_modes": ["token","full"],
          "token_amount": 100,
          "token_refundable": true,
          "refund_policy": "100% refundable up to 2 hours before slot",
          "balance_text": "Balance paid at the restaurant",
          "endpoint": "/follower/prebook"
        },
        "visible_if": "brand_data.accepts_table_booking == true"
      },
      {
        "kind": "transactional",
        "action": "walkin_pay",
        "label": "Pay Bill",
        "config": {
          "fields": ["amount","tip_amount"],
          "payment_modes": ["full"],
          "endpoint": "/follower/pay-at-store"
        }
      },
      {
        "kind": "contact",
        "action": "call",
        "label": "Call",
        "source_fields": ["phone"]
      },
      {
        "kind": "contact",
        "action": "whatsapp",
        "label": "WhatsApp",
        "source_fields": ["whatsapp_phone"]
      },
      {
        "kind": "contact",
        "action": "directions",
        "label": "Directions",
        "source_fields": ["address_line","latitude","longitude"]
      }
    ],
    "photo_requirements": {
      "cover_required": true,
      "gallery_min": 3,
      "gallery_max": 12
    }
  },

  "buyer_config": {
    "discovery_surface": "feed",
    "filters": ["veg_flag", "section", "spice_level", "bestseller"],
    "sort_options": ["distance", "price_low", "price_high", "rating"],
    "default_sort": "distance"
  },

  "card_config": {
    "accent": "#dc2626",
    "accent_dim": "rgba(220,38,38,0.08)",
    "icon": "🍽️",
    "card_type": "menu_item",

    "cta_primary": {
      "label": "Order Now",
      "action": "online_order",
      "color": "#dc2626"
    },

    "price_display": {
      "source": "price.amount",
      "unit": ""
    },

    "subtitle_template": "{section} · {brand_name}",

    "tags": [
      { "source": "veg_flag", "format": "{value}", "highlight_if": "value == 'Veg'" },
      { "source": "bestseller", "text": "⭐ Bestseller", "show_if": true, "highlight": true },
      { "source": "chef_special", "text": "👨‍🍳 Chef's Special", "show_if": true },
      { "source": "spice_level", "format": "🌶 {value}", "show_if": true },
      { "source": "portion_size", "format": "{value}" }
    ],

    "detail_sections": [
      {
        "type": "description",
        "title": "About this dish",
        "source": "description"
      },
      {
        "type": "spec_grid",
        "title": "Details",
        "fields": ["veg_flag", "spice_level", "portion_size", "contains_egg", "jain_available"],
        "emphasized_field": { "key": "bestseller", "color": "amber" }
      }
    ],

    "booking_config": {
      "type": "package",
      "fields": [],
      "payment_modes": ["full"],
      "endpoint": "/follower/orders"
    }
  },

  "action_types": {
    "online_order": {
      "endpoint": "/follower/orders",
      "cart_scope": "brand",
      "min_order_value_field": "min_order_value",
      "delivery_fee_field": "delivery_fee"
    }
  },

  "quality_rules": [
    { "field": "restaurant_description", "scope": "brand", "points": 5, "label": "Add a restaurant description" },
    { "field": "cuisines", "scope": "brand", "points": 5, "label": "Pick up to 4 cuisines" },
    { "field": "hours_json", "scope": "brand", "points": 5, "label": "Set operating hours" },
    { "field": "accepts_table_booking", "scope": "brand", "points": 5, "label": "Enable table booking" },
    { "type": "photos", "scope": "brand", "min": 3, "points": 10, "label": "Add at least 3 ambience photos" },
    { "type": "photos", "scope": "brand", "min": 6, "points": 5, "label": "Add 6+ ambience photos for full gallery" },
    { "items": "menu_items", "min": 10, "points": 15, "label": "Add at least 10 menu items" },
    { "items": "menu_items", "min": 25, "points": 10, "label": "Add 25+ items for a complete menu" }
  ]
}
