{
  "category_key": "restaurant",
  "label": "Restaurant",
  "icon": "🍽️",
  "product_noun": "Menu Item",
  "product_noun_plural": "Menu",
  "super_category": "eat",
  "card_type": "menu_item",
  "phase": 1,
  "status": "active",
  "features": {
    "sections": true,
    "veg_flag": true,
    "duration_mins": false,
    "variants": true,
    "stock": true,
    "booking": true,
    "enquiry_only": false,
    "availability": true,
    "master_catalogue": false,
    "meals": true
  },
  "sections": [
    "Starters",
    "Soups",
    "Main Course",
    "Breads",
    "Rice & Biryani",
    "Sides",
    "Desserts",
    "Beverages"
  ],
  "availing_modes": [
    "prebook",
    "pay_at_store",
    "online_order"
  ],
  "booking_type": null,
  "attributes_schema": {
    "veg_flag": {
      "key": "veg_flag",
      "type": "veg_toggle",
      "label": "Veg / Non-Veg",
      "required": true
    },
    "section": {
      "key": "section",
      "type": "select",
      "label": "Section",
      "options": [
        "Starters",
        "Soups",
        "Main Course",
        "Breads",
        "Rice & Biryani",
        "Sides",
        "Desserts",
        "Beverages"
      ],
      "required": true
    },
    "spice_level": {
      "key": "spice_level",
      "type": "select",
      "label": "Spice Level",
      "options": [
        "Mild",
        "Medium",
        "Hot",
        "Extra Hot"
      ]
    },
    "portion_size": {
      "key": "portion_size",
      "type": "select",
      "label": "Portion",
      "options": [
        "Half",
        "Full",
        "Regular"
      ]
    },
    "bestseller": {
      "key": "bestseller",
      "type": "boolean",
      "label": "Bestseller"
    },
    "chef_special": {
      "key": "chef_special",
      "type": "boolean",
      "label": "Chef's Special"
    },
    "contains_egg": {
      "key": "contains_egg",
      "type": "boolean",
      "label": "Contains Egg"
    },
    "jain_available": {
      "key": "jain_available",
      "type": "boolean",
      "label": "Jain Option Available"
    },
    "description": {
      "key": "description",
      "type": "string",
      "label": "Description",
      "max": 240
    },
    "stock": {
      "key": "stock",
      "type": "number",
      "label": "Daily Stock"
    }
  },
  "cart_scope": "brand",
  "listing_steps": [
    {
      "id": "basics",
      "title": "Basics",
      "subtitle": "Cuisines, vibes, cost — the headline story",
      "component": "brand_fields",
      "writes_to": "brand",
      "field_keys": [
        "cuisines",
        "vibes",
        "cost_for_two",
        "restaurant_description"
      ]
    },
    {
      "id": "location",
      "title": "Location",
      "subtitle": "Verify your address via Google Maps",
      "component": "brand_fields",
      "writes_to": "brand",
      "field_keys": [
        "google_maps_url",
        "locality"
      ]
    },
    {
      "id": "hours",
      "title": "Hours",
      "subtitle": "When you're open through the week",
      "component": "brand_fields",
      "writes_to": "brand",
      "field_keys": [
        "hours_json"
      ]
    },
    {
      "id": "dining_setup",
      "title": "Dining setup",
      "subtitle": "Tables, amenities, what you support",
      "component": "brand_fields",
      "writes_to": "brand",
      "field_keys": [
        "table_count",
        "parking",
        "outdoor_seating",
        "wifi",
        "kids_welcome",
        "wheelchair_accessible",
        "dine_in_supported",
        "takeaway_supported",
        "min_order_value",
        "delivery_fee"
      ]
    },
    {
      "id": "photos",
      "title": "Photos",
      "subtitle": "Show off your space — interior, exterior, signature spreads. Pick a cover.",
      "component": "photo_upload",
      "writes_to": "brand",
      "min_photos": 3,
      "max_photos": 12,
      "recommended_photos": 6,
      "cover_required": true,
      "cover_field_key": "cover_image_url"
    },
    {
      "id": "menu",
      "title": "Menu",
      "subtitle": "Browse popular dishes by cuisine, or bulk-upload an Excel sheet",
      "component": "restaurant_dish_picker",
      "writes_to": "listing",
      "group_by_section": true,
      "max_items": 500,
      "item_fields": [
        {
          "key": "name",
          "type": "string",
          "label": "Item name",
          "required": true,
          "max": 80,
          "placeholder": "e.g. Butter Chicken"
        },
        {
          "key": "price",
          "type": "number",
          "label": "Price",
          "unit": "₹",
          "required": true
        },
        {
          "key": "veg_flag",
          "type": "veg_toggle",
          "label": "Veg / Non-Veg",
          "required": true
        },
        {
          "key": "section",
          "type": "select",
          "label": "Section",
          "required": true,
          "options": [
            "Starters",
            "Soups",
            "Main Course",
            "Breads",
            "Rice & Biryani",
            "Sides",
            "Desserts",
            "Beverages"
          ]
        },
        {
          "key": "description",
          "type": "string",
          "label": "Description",
          "max": 240,
          "placeholder": "Tender chicken simmered in rich tomato gravy"
        },
        {
          "key": "image_url",
          "type": "image",
          "label": "Photo of this dish"
        },
        {
          "key": "spice_level",
          "type": "select",
          "label": "Spice level",
          "options": [
            "Mild",
            "Medium",
            "Hot",
            "Extra Hot"
          ]
        },
        {
          "key": "portion_size",
          "type": "select",
          "label": "Portion",
          "options": [
            "Half",
            "Full",
            "Regular"
          ],
          "default": "Full"
        },
        {
          "key": "bestseller",
          "type": "boolean",
          "label": "Mark as Bestseller",
          "default": false
        },
        {
          "key": "chef_special",
          "type": "boolean",
          "label": "Chef's Special",
          "default": false
        },
        {
          "key": "contains_egg",
          "type": "boolean",
          "label": "Contains egg",
          "default": false
        },
        {
          "key": "jain_available",
          "type": "boolean",
          "label": "Jain option available",
          "default": false
        },
        {
          "key": "stock",
          "type": "number",
          "label": "Daily stock (optional)"
        }
      ]
    },
    {
      "id": "actions",
      "title": "How followers buy",
      "subtitle": "Toggle which CTAs appear on your restaurant page",
      "component": "brand_fields",
      "writes_to": "brand",
      "field_keys": [
        "accepts_table_booking",
        "pay_at_store_supported",
        "online_order_supported",
        "enquiry_enabled"
      ]
    },
    {
      "id": "preview",
      "title": "Preview",
      "subtitle": "How followers will see your restaurant",
      "component": "preview",
      "show_quality_score": true,
      "show_live_preview": true
    },
    {
      "id": "done",
      "title": "You're live!",
      "subtitle": "Your restaurant is now discoverable",
      "component": "done",
      "boost_tips": [
        "Add 6+ ambience photos to feature in 'Highlighted Restaurants'",
        "Mark at least 5 items as Bestsellers — they get priority on cards",
        "Enable table booking to unlock the 'Reservations' badge",
        "Fill descriptions for 80% of menu items to reach Standard quality",
        "Add a delivery fee and minimum order value to enable online order"
      ]
    }
  ],
  "fields": [],
  "product_config": {
    "enabled": true,
    "required": true,
    "excel_upload": true,
    "master_catalogue": false,
    "storage_format": {
      "name": "wizard_state.name",
      "price": "wizard_state.price",
      "master_dish_id": "master_row.id",
      "section": "wizard_state.section",
      "description": "wizard_state.description",
      "image_url": "wizard_state.image_url",
      "variants_json": {
        "veg_flag": "wizard_state.veg_flag",
        "spice_level": "wizard_state.spice_level",
        "portion_size": "wizard_state.portion_size",
        "bestseller": "wizard_state.bestseller",
        "chef_special": "wizard_state.chef_special",
        "contains_egg": "wizard_state.contains_egg",
        "jain_available": "wizard_state.jain_available"
      },
      "availability_json": {
        "daily_stock": "wizard_state.stock"
      }
    },
    "fields": [],
    "excel_columns": [
      {
        "column": "Item Name",
        "field": "name",
        "required": true,
        "example": "Butter Chicken"
      },
      {
        "column": "Section",
        "field": "section",
        "required": true,
        "example": "Main Course"
      },
      {
        "column": "Price (₹)",
        "field": "price",
        "required": true,
        "example": "320"
      },
      {
        "column": "Veg/Non-Veg",
        "field": "veg_flag",
        "required": true,
        "example": "Non-Veg"
      },
      {
        "column": "Description",
        "field": "description",
        "required": false,
        "example": "Tender chicken in rich tomato gravy"
      },
      {
        "column": "Spice Level",
        "field": "spice_level",
        "required": false,
        "example": "Medium"
      },
      {
        "column": "Portion",
        "field": "portion_size",
        "required": false,
        "example": "Full"
      },
      {
        "column": "Bestseller",
        "field": "bestseller",
        "required": false,
        "example": "Yes"
      },
      {
        "column": "Chef's Special",
        "field": "chef_special",
        "required": false,
        "example": "No"
      },
      {
        "column": "Contains Egg",
        "field": "contains_egg",
        "required": false,
        "example": "No"
      },
      {
        "column": "Jain Option",
        "field": "jain_available",
        "required": false,
        "example": "No"
      },
      {
        "column": "Daily Stock",
        "field": "stock",
        "required": false,
        "example": "50"
      },
      {
        "column": "Image URL",
        "field": "image_url",
        "required": false,
        "example": "https://example.com/dish.jpg"
      }
    ]
  },
  "brand_config": {
    "fields": {
      "cuisines": {
        "key": "cuisines",
        "type": "multi_select",
        "label": "Cuisines",
        "options": [
          "North Indian",
          "South Indian",
          "Chinese",
          "Continental",
          "Biryani",
          "Tandoor",
          "Mughlai",
          "Andhra",
          "Hyderabadi",
          "Bengali",
          "Gujarati",
          "Punjabi",
          "Italian",
          "Mexican",
          "Thai",
          "Japanese",
          "Desserts",
          "Fast Food",
          "Cafe",
          "Beverages"
        ],
        "required": true,
        "max": 4
      },
      "vibes": {
        "key": "vibes",
        "type": "multi_select",
        "label": "Vibes",
        "options": [
          "fine_dining",
          "cafe",
          "quickbite",
          "rooftop",
          "nightlife",
          "family",
          "buffet",
          "five_star",
          "date_night",
          "birthday",
          "late_night"
        ],
        "max": 4,
        "help": "Pick up to 4 that match your atmosphere"
      },
      "cost_for_two": {
        "key": "cost_for_two",
        "type": "number",
        "label": "Cost for two (₹)",
        "unit": "₹",
        "min": 100,
        "max": 10000,
        "required": true,
        "help": "Approximate, without alcohol"
      },
      "google_maps_url": {
        "key": "google_maps_url",
        "type": "google_maps_link",
        "label": "Google Maps URL",
        "required": true,
        "help": "Paste your Google Maps share link. We'll verify and auto-fill location.",
        "writes_to_keys": [
          "lat",
          "lng",
          "locality",
          "formatted_address"
        ]
      },
      "locality": {
        "key": "locality",
        "type": "string",
        "label": "Locality",
        "required": true,
        "help": "e.g. Banjara Hills, Hitech City. Auto-filled from Maps; edit if you want a different display name."
      },
      "cover_image_url": {
        "key": "cover_image_url",
        "type": "image",
        "label": "Cover photo",
        "help": "Pick one from your gallery to be the headline image",
        "source_step": "photos"
      },
      "restaurant_description": {
        "key": "restaurant_description",
        "type": "string",
        "label": "About your restaurant",
        "max": 280,
        "placeholder": "Two lines about your kitchen, your story, your specialty"
      },
      "hours_json": {
        "key": "hours_json",
        "type": "weekly_schedule",
        "label": "Operating hours",
        "required": true
      },
      "photos": {
        "key": "photos",
        "type": "image[]",
        "label": "Restaurant photos",
        "max": 12
      },
      "table_count": {
        "key": "table_count",
        "type": "number",
        "label": "Number of tables"
      },
      "parking": {
        "key": "parking",
        "type": "boolean",
        "label": "Parking available",
        "default": false
      },
      "outdoor_seating": {
        "key": "outdoor_seating",
        "type": "boolean",
        "label": "Outdoor seating",
        "default": false
      },
      "wifi": {
        "key": "wifi",
        "type": "boolean",
        "label": "Free Wi-Fi",
        "default": false
      },
      "kids_welcome": {
        "key": "kids_welcome",
        "type": "boolean",
        "label": "Kids welcome",
        "default": false
      },
      "wheelchair_accessible": {
        "key": "wheelchair_accessible",
        "type": "boolean",
        "label": "Wheelchair accessible",
        "default": false
      },
      "dine_in_supported": {
        "key": "dine_in_supported",
        "type": "boolean",
        "label": "Dine-in available",
        "default": true
      },
      "takeaway_supported": {
        "key": "takeaway_supported",
        "type": "boolean",
        "label": "Takeaway available",
        "default": true
      },
      "accepts_table_booking": {
        "key": "accepts_table_booking",
        "type": "boolean",
        "label": "Accept table bookings",
        "default": true
      },
      "pay_at_store_supported": {
        "key": "pay_at_store_supported",
        "type": "boolean",
        "label": "Pay at Restaurant",
        "default": true,
        "help": "Followers can scan + pay their bill via INFLX, with discount auto-applied"
      },
      "online_order_supported": {
        "key": "online_order_supported",
        "type": "boolean",
        "label": "Online order / delivery",
        "default": false,
        "help": "Enable if you support delivery or takeaway orders through INFLX"
      },
      "enquiry_enabled": {
        "key": "enquiry_enabled",
        "type": "boolean",
        "label": "Enquiry CTA",
        "default": true,
        "help": "Show a 'Send Enquiry' button for catering / private events"
      },
      "min_order_value": {
        "key": "min_order_value",
        "type": "number",
        "label": "Minimum order value",
        "unit": "₹",
        "default": 0
      },
      "delivery_fee": {
        "key": "delivery_fee",
        "type": "number",
        "label": "Delivery fee",
        "unit": "₹",
        "default": 0
      },
      "free_delivery": {
        "key": "free_delivery",
        "type": "toggle",
        "label": "Free delivery",
        "help": "Show a 'Free Delivery' badge on your restaurant card"
      },
      "delivery_eta_min_mins": {
        "key": "delivery_eta_min_mins",
        "type": "number",
        "label": "Delivery time — from (mins)",
        "unit": "min"
      },
      "delivery_eta_max_mins": {
        "key": "delivery_eta_max_mins",
        "type": "number",
        "label": "Delivery time — to (mins)",
        "unit": "min"
      }
    },
    "actions": [
      {
        "kind": "transactional",
        "action": "book_slot",
        "label": "Book a Table",
        "priority": 1,
        "primary": true,
        "config": {
          "booking_type": "table",
          "fields": [
            "booking_date",
            "time_slot",
            "guest_count",
            "special_requests"
          ]
        }
      },
      {
        "kind": "transactional",
        "action": "pay_at_store",
        "label": "Pay at Restaurant",
        "priority": 2,
        "config": {
          "fields": [
            "amount"
          ]
        }
      },
      {
        "kind": "transactional",
        "action": "online_order",
        "label": "Order Online",
        "priority": 3,
        "config": {}
      },
      {
        "kind": "contact",
        "action": "directions",
        "label": "Directions",
        "source_fields": [
          "google_maps_url",
          "address_line",
          "latitude"
        ]
      }
    ],
    "photo_requirements": {
      "cover_required": true,
      "gallery_min": 3,
      "gallery_max": 12
    }
  },
  "buyer_config": {
    "discovery_surface": "feed",
    "filters": [
      {
        "key": "veg_only",
        "type": "boolean",
        "label": "🟢 Veg only",
        "source": "products.veg_flag"
      },
      {
        "key": "vibes",
        "type": "multi_select",
        "label": "Vibes",
        "source": "brand.vibes",
        "options": [
          "fine_dining",
          "cafe",
          "quickbite",
          "rooftop",
          "nightlife",
          "family",
          "buffet",
          "five_star",
          "date_night",
          "birthday",
          "late_night"
        ]
      },
      {
        "key": "cuisines",
        "type": "multi_select",
        "label": "Cuisines",
        "source": "brand.cuisines"
      },
      {
        "key": "cost_for_two",
        "type": "range",
        "label": "Cost",
        "source": "brand.cost_for_two",
        "buckets": [
          {
            "key": "under_300",
            "label": "Under ₹300",
            "max": 300
          },
          {
            "key": "300_800",
            "label": "₹300 – ₹800",
            "min": 300,
            "max": 800
          },
          {
            "key": "800_plus",
            "label": "₹800+",
            "min": 800
          }
        ]
      },
      {
        "key": "open_now",
        "type": "boolean",
        "label": "⏱ Open now",
        "computed_from": "brand.hours_json"
      },
      {
        "key": "has_offers",
        "type": "boolean",
        "label": "🏷 Has offers"
      },
      {
        "key": "creator_trusted",
        "type": "boolean",
        "label": "⭐ Creator trusted (3+)"
      }
    ],
    "sort_options": [
      {
        "key": "distance",
        "label": "Distance",
        "default": true,
        "computed_from": "haversine(brand.lat,lng, follower.lat,lng)"
      },
      {
        "key": "rating",
        "label": "Rating"
      },
      {
        "key": "cost_asc",
        "label": "Cost: low → high"
      },
      {
        "key": "cost_desc",
        "label": "Cost: high → low"
      },
      {
        "key": "popularity",
        "label": "Popularity"
      },
      {
        "key": "newest",
        "label": "Newest"
      }
    ],
    "default_sort": "distance"
  },
  "card_config": {
    "accent": "#dc2626",
    "accent_dim": "rgba(220,38,38,0.08)",
    "icon": "🍽️",
    "card_type": "menu_item",
    "cta_primary": {
      "label": "Order Now",
      "action": "online_order",
      "color": "#dc2626"
    },
    "price_display": {
      "source": "price.amount",
      "unit": ""
    },
    "subtitle_template": "{section} · {brand_name}",
    "tags": [
      {
        "source": "veg_flag",
        "format": "{value}",
        "highlight_if": "value == 'Veg'"
      },
      {
        "source": "bestseller",
        "text": "⭐ Bestseller",
        "show_if": true,
        "highlight": true
      },
      {
        "source": "chef_special",
        "text": "👨‍🍳 Chef's Special",
        "show_if": true
      },
      {
        "source": "spice_level",
        "format": "🌶 {value}",
        "show_if": true
      },
      {
        "source": "portion_size",
        "format": "{value}"
      }
    ],
    "detail_sections": [
      {
        "type": "description",
        "title": "About this dish",
        "source": "description"
      },
      {
        "type": "spec_grid",
        "title": "Details",
        "fields": [
          "veg_flag",
          "spice_level",
          "portion_size",
          "contains_egg",
          "jain_available"
        ],
        "emphasized_field": {
          "key": "bestseller",
          "color": "amber"
        }
      }
    ],
    "booking_config": {
      "type": "package",
      "fields": [],
      "payment_modes": [
        "full"
      ],
      "endpoint": "/follower/orders"
    }
  },
  "action_types": {
    "online_order": {
      "endpoint": "/follower/orders",
      "cart_scope": "brand",
      "min_order_value_field": "min_order_value",
      "delivery_fee_field": "delivery_fee"
    }
  },
  "quality_rules": [
    {
      "field": "restaurant_description",
      "scope": "brand",
      "points": 5,
      "label": "Description filled"
    },
    {
      "field": "cuisines",
      "scope": "brand",
      "points": 5,
      "label": "At least 1 cuisine",
      "min_count": 1
    },
    {
      "field": "vibes",
      "scope": "brand",
      "points": 5,
      "label": "At least 1 vibe",
      "min_count": 1
    },
    {
      "field": "cost_for_two",
      "scope": "brand",
      "points": 5,
      "label": "Cost for two set"
    },
    {
      "field": "google_maps_url",
      "scope": "brand",
      "points": 10,
      "label": "Location verified"
    },
    {
      "field": "hours_json",
      "scope": "brand",
      "points": 10,
      "label": "Operating hours set"
    },
    {
      "field": "cover_image_url",
      "scope": "brand",
      "points": 10,
      "label": "Cover photo picked"
    },
    {
      "type": "photos",
      "scope": "brand",
