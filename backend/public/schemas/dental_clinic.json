    { "field": "business_name", "points": 20, "label": "Clinic name & contact" },
    { "items": "treatment", "min": 2, "points": 25, "label": "2+ treatments listed" },
    { "type": "photos", "min": 1, "points": 20, "label": "Photos uploaded" },
