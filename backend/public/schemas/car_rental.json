{
  "category_key": "car_rental",
  "label": "Car Rental",
  "icon": "🚗",
  "product_noun": "Vehicle",
  "product_noun_plural": "Fleet",
  "features": {
    "sections": true,
    "veg_flag": false,
    "duration_mins": false,
    "variants": true,
    "stock": false,
    "booking": true,
    "enquiry_only": false,
    "availability": true,
    "master_catalogue": true
  },
  "sections": [
    "Hatchback",
    "Sedan",
    "SUV",
    "MUV",
    "Luxury",
    "Mini Bus"
  ],
  "booking_type": "vehicle",
  "availing_modes": [
    "prebook"
  ],
  "fields": [
    {
      "key": "name",
      "label": "Vehicle Model",
      "type": "text",
      "required": true,
      "placeholder": "e.g. Toyota Innova"
    },
    {
      "key": "section",
      "label": "Vehicle Type",
      "type": "select",
      "options": [
        "Sedan",
        "SUV",
        "Hatchback",
        "Luxury",
        "Mini Bus",
        "Truck"
      ],
      "required": false
    },
    {
      "key": "price",
      "label": "Price per day (₹)",
      "type": "number",
      "required": true,
      "placeholder": "2500"
    },
    {
      "key": "description",
      "label": "Features",
      "type": "textarea",
      "required": false,
      "placeholder": "AC, GPS, Fuel type..."
    },
    {
      "key": "image_url",
      "label": "Image URL",
      "type": "url",
      "required": false
    },
    {
      "key": "availability_json",
      "label": "Available Days",
      "type": "availability_picker",
      "required": false
    },
    {
      "key": "variants_json",
      "label": "Duration Packages",
      "type": "variant_builder",
      "required": false,
      "placeholder": "e.g. Half day / Full day / Weekly"
    }
  ],
  "buyer_config": {
    "show_veg_filter": false,
    "show_sections": true,
    "cta_label": "Book Now"
  },
  "phase": 3,
  "status": "coming_soon",
  "super_category": "travel",
  "action_types": {
    "book_now": {
      "enabled": true,
      "type": "date_range",
      "cta_label": "Book Vehicle",
      "requires_date": true,
      "requires_time_slot": false,
      "payment_mode": "token_or_full"
    },
    "walkin_pay": {
      "enabled": false
    },
    "enquiry": {
      "enabled": true,
      "cta_label": "Get Quote"
    }
  },
  "listing_steps": [],
  "product_config": {
    "enabled": true,
    "required": false,
    "excel_upload": false,
    "fields": []
  },
  "card_config": {
    "accent": "#f59e0b",
    "accent_dim": "rgba(245,158,11,0.1)",
    "icon": "🚗",
    "cta_primary": {
      "label": "Book",
      "action": "book_slot",
      "color": "#f59e0b"
    },
    "cta_secondary": {
      "label": "Enquire",
      "action": "enquiry"
    },
    "price_display": {
      "source": "cheapest_item",
      "unit": "/day"
    },
    "subtitle_template": "{locality} · {distance}",
    "tags": [
      "vehicle_types",
      "ac_available"
    ]
  },
  "quality_rules": [
    {
      "field": "business_name",
      "points": 20,
      "label": "Business name & contact"
    },
    {
      "items": "vehicle",
      "min": 2,
      "points": 20,
      "label": "2+ vehicles"
    },
    {
      "type": "photos",
      "min": 1,
      "points": 15,
      "label": "Photos uploaded"
    }
  ]
}
